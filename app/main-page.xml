<Page xmlns="http://schemas.nativescript.org/tns.xsd" navigatingTo="onNavigatingTo" backgroundColor="#ffffff">
  <ActionBar title="Script Runner" backgroundColor="#f8fafc" color="#111827" />
  <ScrollView>
    <StackLayout padding="20" spacing="14" backgroundColor="#ffffff">
      <Label id="headline" text="NativeScript / napi-ios Script Runner" fontSize="22" fontWeight="bold" color="#111827" textWrap="true" accessibilityLabel="NativeScript napi-ios Script Runner" />
      <Label id="introLabel" text="Import a local .js/.mjs/.txt file, inspect it, then run it explicitly." fontSize="15" color="#334155" textWrap="true" />
      <Label id="warningLabel" text="Warning: imported code executes with the native capabilities exposed by the runtime. Only run code you trust." fontSize="14" color="#9b1c1c" textWrap="true" />

      <Button id="importButton" text="Import Script" height="48" fontSize="16" color="#0f172a" backgroundColor="#e2e8f0" borderColor="#94a3b8" borderWidth="1" borderRadius="8" accessibilityLabel="Import Script" accessibilityHint="Choose a JavaScript file to load" tap="onImport" />
      <Label id="fileNameLabel" text="{{ fileName }}" fontSize="15" fontWeight="bold" color="#111827" textWrap="true" accessibilityLabel="{{ fileName }}" />

      <TextView id="sourceView" text="{{ source }}" editable="false" height="300" fontSize="14" color="#111827" backgroundColor="#f8fafc" borderColor="#cbd5e1" borderWidth="1" borderRadius="8" hint="No script loaded" accessibilityLabel="Script source" />

      <Button id="runButton" text="Run Script" height="48" fontSize="16" color="#0f172a" backgroundColor="#e2e8f0" borderColor="#94a3b8" borderWidth="1" borderRadius="8" accessibilityLabel="Run Script" accessibilityHint="Execute the loaded script" tap="onRun" isEnabled="{{ canRun }}" />
      <Button id="clearButton" text="Clear Console" height="48" fontSize="16" color="#0f172a" backgroundColor="#e2e8f0" borderColor="#94a3b8" borderWidth="1" borderRadius="8" accessibilityLabel="Clear Console" accessibilityHint="Clear script output" tap="onClearConsole" />

      <Label id="consoleTitle" text="Console" fontSize="18" fontWeight="bold" color="#111827" accessibilityLabel="Console" />
      <TextView id="outputView" text="{{ output }}" editable="false" height="240" fontSize="14" color="#111827" backgroundColor="#f8fafc" borderColor="#cbd5e1" borderWidth="1" borderRadius="8" accessibilityLabel="Script console output" />
    </StackLayout>
  </ScrollView>
</Page>
